{
	"name": "fnlb",
	"version": "1.1.24",
	"author": "FNLB",
	"main": "dist/index.js",
	"homepage": "https://developers.fnlb.net/docs/sdk/overview",
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"bun-plugin-dts": "^0.3.0",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.14.1",
		"typescript": "^7.0.0"
	},
	"overrides": {
		"typescript": "^7.0.0"
	},
	"description": "Easily run your own bot using FNLB, a powerful and scalable system for managing Fortnite Lobby bots and getting Bot Lobbies.",
	"files": [
		"dist"
	],
	"keywords": [
		"fnlb",
		"fortnite",
		"lobbybot",
		"self-host",
		"botlobbies"
	],
	"license": "ISC",
	"packageManager": "bun@1.1.17",
	"scripts": {
		"build": "bun run src/build.ts",
		"prepublishOnly": "bun run lint && bun run build --env=disable",
		"test:node": "bun run build && node test/node.js",
		"lint": "bun run lint:biome && bun run lint:tsc",
		"lint:biome": "bunx --bun @biomejs/biome check --write .",
		"lint:tsc": "bun tsc --noEmit",
		"docs": "typedoc",
		"test": "bun run lint && bun test"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"type": "module",
	"types": "dist/index.d.ts",
	"dependencies": {
		"@fnlb-project/shared": "^1.5.193"
	}
}
